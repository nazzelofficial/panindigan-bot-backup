# =========================================================
# PANINDIGAN DISCORD BOT — Environment Variables Reference
# Copy this file to .env and fill in your values.
# =========================================================

# ─── DISCORD ─────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Bot prefix (default defined in config.json)
BOT_PREFIX=p!

# Owner IDs (comma-separated Discord user IDs)
OWNER_IDS=123456789012345678,987654321098765432

# ─── DATABASE — PostgreSQL (Prisma) ──────────────────────
# For local dev: postgresql://user:password@localhost:5432/panindigan
# For production: use your managed Postgres URL
DATABASE_URL=postgresql://username:password@localhost:5432/panindigan?schema=public
POSTGRES_URL=postgresql://username:password@localhost:5432/panindigan

# ─── DATABASE — MongoDB ──────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/panindigan
# Or Atlas: mongodb+srv://username:password@cluster.mongodb.net/panindigan

# ─── DATABASE — Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Or with auth: redis://:password@localhost:6379
# Or Upstash: rediss://username:password@host.upstash.io:6380

# ─── SESSION ─────────────────────────────────────────────
SESSION_SECRET=a_very_long_random_secret_for_sessions_change_this

# ─── AI PROVIDERS ────────────────────────────────────────
# OpenAI (for ChatGPT, DALL-E image generation)
OPENAI_API_KEY=sk-proj-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=AIza...

# Groq (fast LLM inference)
GROQ_API_KEY=gsk_...

# ─── LAVALINK / MUSIC ────────────────────────────────────
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Optional: Additional Lavalink nodes (JSON array)
# LAVALINK_NODES=[{"host":"node2.example.com","port":2333,"auth":"password","name":"Node2","secure":false}]

# ─── OPTIONAL SERVICES ───────────────────────────────────
# Sentry error tracking
SENTRY_DSN=https://...@sentry.io/...

# Top.gg bot listing
TOPGG_TOKEN=your_topgg_token

# Webhook for logging (Discord webhook URL)
LOG_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─── SHARDING ────────────────────────────────────────────
# Set to 'auto' to let Discord decide, or a number
SHARD_COUNT=auto

# ─── NODE ────────────────────────────────────────────────
NODE_ENV=development
# NODE_ENV=production
