{
  "name": "panindigan-bot",
  "version": "0.1.0",
  "description": "All-in-One Discord Bot — Modern, powerful, and always ready",
  "type": "module",
  "main": "dist/bot/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/bot/index.ts",
    "start": "node dist/bot/index.js",
    "shard": "node dist/bot/shard.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs panindigan",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "music",
    "ai",
    "economy",
    "moderation",
    "games",
    "filipino"
  ],
  "author": "Panindigan Bot",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@discordjs/voice": "^0.19.2",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/utilities": "^3.18.2",
    "@types/pg": "^8.20.0",
    "canvas": "^3.2.3",
    "chalk": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "effect": "^3.22.0",
    "groq-sdk": "^1.4.0",
    "i18next": "^23.3.6",
    "i18next-fs-backend": "^2.6.6",
    "kazagumo": "^3.4.3",
    "mongodb": "^7.5.0",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "pm2": "^7.0.3",
    "pure-rand": "^6.1.0",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "shoukaku": "^4.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "proper-lockfile>signal-exit": "^3.0.7"
    }
  }
}
