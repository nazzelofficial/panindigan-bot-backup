{
  "name": "panindigan-bot",
  "version": "0.1.0",
  "description": "All-in-One Discord Bot — Modern, powerful, and always ready",
  "main": "dist/bot/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/bot/index.ts",
    "start": "node dist/bot/index.js",
    "shard": "node dist/bot/shard.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs panindigan",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "music",
    "ai",
    "economy",
    "moderation",
    "games",
    "filipino"
  ],
  "author": "Panindigan Bot",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@discordjs/voice": "^0.17.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "@sapphire/discord.js-utilities": "^3.2.3",
    "@sapphire/plugin-logger": "^3.0.4",
    "@sapphire/time-utilities": "^1.7.1",
    "@sapphire/utilities": "^3.0.5",
    "canvas": "^2.11.2",
    "chalk": "^4.1.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.7.0",
    "i18next": "^23.16.8",
    "i18next-fs-backend": "^2.3.1",
    "kazagumo": "^4.2.0",
    "mongodb": "^6.11.0",
    "openai": "^4.73.0",
    "pm2": "^5.4.2",
    "redis": "^4.7.0",
    "sharp": "^0.33.5",
    "shoukaku": "^4.2.0",
    "winston": "^3.16.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.15.1"
  },
  "packageManager": "pnpm@11.15.1"
}
